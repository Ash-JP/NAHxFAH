# =============================================================================
# WIFI HUNTER AR — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://wifi_hunter:change_me@postgres:5432/wifi_hunter?sslmode=disable
POSTGRES_USER=wifi_hunter
POSTGRES_PASSWORD=change_me
POSTGRES_DB=wifi_hunter

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# API key that all Windows hubs must send during registration.
# Use a long random string in production:
#   openssl rand -hex 32
HUB_API_KEY=change_me_to_a_long_random_secret

# ---------------------------------------------------------------------------
# BSSID Privacy
# ---------------------------------------------------------------------------
# When true, BSSIDs are stored as SHA-256(BSSID + SERVER_SECRET).
# The same AP always produces the same identifier (deterministic hashing).
# Default: false (store raw BSSIDs for development)
BSSID_HASHING=false
SERVER_SECRET=change_me_for_bssid_hashing

# ---------------------------------------------------------------------------
# RSSI Signal Processing
# ---------------------------------------------------------------------------
# Exponential Moving Average alpha for RSSI smoothing.
# Range: 0.0 (no update) – 1.0 (no memory)
# Default: 0.25
RSSI_SMOOTHING_ALPHA=0.25

# ---------------------------------------------------------------------------
# Path Loss Model
# ---------------------------------------------------------------------------
# RSSI = A - 10 * n * log10(d)
# These are calibration parameters — NOT universal constants.
# Tune these for your specific environment.
# A: RSSI at 1m reference distance (dBm), typical: -40 to -55
# n: Path loss exponent, free space=2, indoor typical: 2.5–4.0
PATH_LOSS_A=-45.0
PATH_LOSS_N=3.0

# ---------------------------------------------------------------------------
# Localization
# ---------------------------------------------------------------------------
# Minimum number of spatially-useful hubs required to attempt localization.
LOCALIZATION_MIN_HUBS=3

# Sliding window in seconds for aggregating observations per hub+BSSID.
LOCALIZATION_WINDOW_SECONDS=45

# Position smoothing alpha (EMA). Lower = more stable, slower response.
POSITION_SMOOTHING_ALPHA=0.3

# Grid resolution for position search (meters).
LOCALIZATION_GRID_RESOLUTION=0.5

# ---------------------------------------------------------------------------
# Hub Management
# ---------------------------------------------------------------------------
# Seconds after last heartbeat before hub is marked STALE.
HUB_STALE_THRESHOLD_SECONDS=15

# Seconds after last heartbeat before hub is marked OFFLINE.
HUB_OFFLINE_THRESHOLD_SECONDS=30

# ---------------------------------------------------------------------------
# Observation Retention
# ---------------------------------------------------------------------------
# Raw observations older than this are purged (AP state is preserved).
OBSERVATION_RETENTION_HOURS=24

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Options: debug, info, warn, error
LOG_LEVEL=info
